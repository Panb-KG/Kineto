# ── Kineto Web 环境变量示例 ─────────────────────────────────────────────
# 复制为 .env.local 后按需填写。开发环境下若不配置或引擎不可达，
# 应用会自动回退到内置 fixture: public/fixtures/pose_data.sample.json
#
# ⚠️ 安全铁律：
#   - NEXT_PUBLIC_* 变量会在【构建期】被内联进浏览器包，对所有人可见；
#     改动后必须【重新部署】才会生效。
#   - 任何密钥都【绝不能】使用 NEXT_PUBLIC_ 前缀。
#   - 引擎地址与 API Key 都是【服务端】变量（无前缀），只在 Next.js
#     Route Handler（app/api/[...path]/route.ts）中读取，浏览器永远看不到。
#
# 架构：浏览器 → 同源 /api/* → 服务端代理注入 X-API-Key → 引擎（ENGINE_API_BASE）

# ── 服务端变量（无 NEXT_PUBLIC_ 前缀，仅服务端可见）─────────────────────

# 引擎 API 基址（FastAPI 服务）——运行时读取，改环境变量即时生效，无需重新构建。
# 多模式（ADR-001）：按【部署侧在哪里】选择可达的引擎地址：
#
#   模式            部署侧位置          ENGINE_API_BASE 取值                      可达性依据
#   ──────────────  ─────────────────  ─────────────────────────────────────────  ─────────────────────
#   tailscale-dev   Mac（本地 next dev）  http://aibox:8000                          Mac 在 tailnet（Panb-KG@）
#   lan             客户内网机器/设备     http://juxin.lan:8000                      路由器本地 DNS
#   public-prod     Zeabur（生产）       https://aibox.tail6791a3.ts.net            Tailscale Funnel（公网入口，
#                                                                     已启用；与 tailnet 同守护进程，零冲突）
#
# ⚠️ 关键约束：Zeabur 服务端【不在 tailnet 也不在客户内网】，aibox:8000 与
#    juxin.lan:8000 从 Zeabur 均不可达；Zeabur 生产用 Funnel 公网地址。
#    Funnel 已在设备启用（tailscale funnel --bg 8000），重启自动恢复。
ENGINE_API_BASE=

# 访问引擎所需的 API Key，由代理作为 X-API-Key 请求头在【服务端】注入。
# 切勿改成 NEXT_PUBLIC_API_KEY —— 那会把密钥泄露进浏览器包。
KINETO_API_KEY=

# ── 浏览器侧变量（可选）──────────────────────────────────────────────

# 浏览器调用的同源 API 前缀。【强烈建议留空】，默认即走同源代理 /api。
# ⚠️ 不要填旧式绝对 URL（如 https://kineto-api.<DOMAIN>）：那会让浏览器绕过同源
#    代理直连引擎，而引擎需 X-API-Key（浏览器不持有）→ 大概率 401；
#    dev 下若检测到 "://" 会在控制台打印警告。
NEXT_PUBLIC_API_BASE=

# 上传后轮询任务的超时（毫秒）。引擎处理最长可达 2h，默认 1h(3600000)。
# 超时不会误报“未连接引擎”，而是保留 job_id 并提示“任务仍在处理中/继续等待”。
NEXT_PUBLIC_POLL_TIMEOUT_MS=

# ── 代理行为说明（无对应 env，写死于 app/api/[...path]/route.ts）─────
# • 限流：POST /jobs 每 IP 每 10min 最多 3 次，超限返回 429 + Retry-After（内存态，
#   单实例级；多实例/多副本部署下为已接受的残留风险）。
# • 白名单：仅放行 POST /jobs、GET /jobs/{id}、GET /jobs/{id}/pose_data.json、
#   GET /jobs/{id}/demo_output.mp4、GET /health、GET /healthz；其余一律 404。
